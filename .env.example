# This is an example of the .env needed to run doven-kalender.
# Copy this file to .env and fill in the required values.
# Make sure to keep this file, .env, secret and do not share it publicly.

# Document extraction
DOCS_DOCUMENT_URL=...
DOCS_COOKIE=...
DOCS_ODT_FILE=...

# Intake / kalender keys
GOOGLE_API_KEY=...
GOOGLE_CALENDAR_ID=...

# Generator keys
GEMINI_KEY=...
MISTRAL_KEY=...
OPENAI_KEY=...
DOVEN_LLM_PROVIDER=...

# Poster keys
FACEBOOK_API_KEY=...
EMAIL_USERNAME=...
EMAIL_PASSWORD=...
EMAIL_HOST=...
